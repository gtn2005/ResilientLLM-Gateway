{
  "uid": "resilient-llm",
  "title": "RESILIENT // Gateway Operations",
  "tags": ["llm", "resilience", "gateway"],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "5s",
  "time": {"from": "now-15m", "to": "now"},
  "panels": [
    {
      "id": 1, "title": "REQUEST VELOCITY", "type": "timeseries", "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "targets": [{"expr": "sum(rate(gateway_requests_total[1m]))", "legendFormat": "requests / sec"}],
      "fieldConfig": {"defaults": {"color": {"mode": "fixed", "fixedColor": "#ff6b45"}, "unit": "reqps"}}
    },
    {
      "id": 2, "title": "LATENCY DISTRIBUTION", "type": "timeseries", "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "targets": [
        {"expr": "histogram_quantile(0.50, sum by (le) (rate(gateway_request_duration_seconds_bucket[5m])))", "legendFormat": "p50"},
        {"expr": "histogram_quantile(0.95, sum by (le) (rate(gateway_request_duration_seconds_bucket[5m])))", "legendFormat": "p95"},
        {"expr": "histogram_quantile(0.99, sum by (le) (rate(gateway_request_duration_seconds_bucket[5m])))", "legendFormat": "p99"}
      ],
      "fieldConfig": {"defaults": {"unit": "s"}}
    },
    {
      "id": 3, "title": "ERROR RATE", "type": "stat", "gridPos": {"x": 0, "y": 8, "w": 6, "h": 6},
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "targets": [{"expr": "sum(rate(gateway_requests_total{status=~\"5..\"}[5m])) / clamp_min(sum(rate(gateway_requests_total[5m])), 0.001)", "legendFormat": "errors"}],
      "fieldConfig": {"defaults": {"unit": "percentunit", "thresholds": {"mode": "absolute", "steps": [{"color": "green"}, {"color": "red", "value": 0.01}]}}}
    },
    {
      "id": 4, "title": "CACHE HIT RATE", "type": "stat", "gridPos": {"x": 6, "y": 8, "w": 6, "h": 6},
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "targets": [{"expr": "sum(rate(gateway_cache_total{result=\"hit\"}[5m])) / clamp_min(sum(rate(gateway_cache_total[5m])), 0.001)", "legendFormat": "hit rate"}],
      "fieldConfig": {"defaults": {"unit": "percentunit", "color": {"mode": "fixed", "fixedColor": "#b4eb62"}}}
    },
    {
      "id": 5, "title": "CIRCUIT STATE", "type": "state-timeline", "gridPos": {"x": 12, "y": 8, "w": 12, "h": 6},
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "targets": [{"expr": "gateway_circuit_state", "legendFormat": "{{provider}}"}],
      "fieldConfig": {"defaults": {"mappings": [{"type": "value", "options": {"0": {"text": "CLOSED", "color": "green"}, "1": {"text": "HALF OPEN", "color": "yellow"}, "2": {"text": "OPEN", "color": "red"}}}]}}
    },
    {
      "id": 6, "title": "PROVIDER CALLS / FAILOVERS", "type": "timeseries", "gridPos": {"x": 0, "y": 14, "w": 24, "h": 8},
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "targets": [
        {"expr": "sum by (provider) (rate(gateway_provider_calls_total[1m]))", "legendFormat": "{{provider}} calls"},
        {"expr": "sum(rate(gateway_failover_total[1m]))", "legendFormat": "failovers"}
      ],
      "fieldConfig": {"defaults": {"unit": "reqps"}}
    }
  ]
}
